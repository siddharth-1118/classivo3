# Backend & Portal URLs
NEXT_PUBLIC_BACKEND_URL=https://your-backend-url.com
PORTAL_BACKEND_URL=https://your-portal-backend-url.com
NEXT_PUBLIC_APK_URL=https://your-domain.com/classivo.apk
NEXT_PUBLIC_NEST_URL=https://your-domain.com
NEXT_PUBLIC_MAINTENANCE=false

# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# VAPID / WebPush Credentials
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Admin & SSO Secrets
NEXT_PUBLIC_ADMIN_KEY=your-admin-key
NEXT_PUBLIC_SSO_SECRET=your-sso-secret
