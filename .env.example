DATABASE_URL="file:./dev.db"
# For production: DATABASE_URL="postgresql://user:pw@localhost:5432/srm_companion"

NODE_ENV=development

MOCK_MODE=false

PORTAL_BASE_URL=https://sp.srmist.edu.in
PORTAL_LOGIN_PATH=/srmiststudentportal/students/loginManager/youLogin.jsp

SESSION_TTL_MS=604800000
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=10

RATE_LIMIT_ENABLED=true
DEBUG_SNAPSHOTS=true

# Optional: override default auth cookie name
# APP_AUTH_COOKIE_NAME=app_session

NEXT_PUBLIC_APP_NAME="SRM Student Companion"

# Set to "true" to show the maintenance page across the entire site
NEXT_PUBLIC_MAINTENANCE=false
